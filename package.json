{
  "name": "hub",
  "version": "1.0.0",
  "private": true,
  "description": "Hub — Node.js 全栈综合站点（博客 / 笔记 / 待办 / 书签 / 短链 / 图床 / 聊天室 / 仪表盘），零第三方依赖。",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "reset": "node server/scripts/reset.js",
    "seed": "node server/scripts/reset.js --seed-only",
    "smoke": "node server/scripts/smoke.js"
  },
  "keywords": [
    "nodejs",
    "sqlite",
    "spa",
    "blog",
    "websocket",
    "vanilla"
  ],
  "license": "MIT"
}
