# 复制为 .env 后按需修改（全部为可选项，不配置也能跑）
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# 会话签名密钥：生产环境务必改成随机长字符串（node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"）
JWT_SECRET=change-me-to-a-long-random-string

# 管理员账号（首次启动时自动创建）
ADMIN_EMAIL=admin@hub.dev
ADMIN_PASSWORD=admin12345

# 单个上传文件大小上限（字节）
MAX_UPLOAD_BYTES=10485760
