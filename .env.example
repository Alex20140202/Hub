# 复制为 .env 后按需修改（全部为可选项，不配置也能跑）
PORT=4000
HOST=127.0.0.1
NODE_ENV=development

# 会话签名密钥：生产环境必填，否则启动即报错
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# 首次启动时自动创建的管理员账号
ADMIN_EMAIL=admin@hub.dev
ADMIN_PASSWORD=admin12345

# 首次启动时自动创建的演示账号（附带示例笔记/待办/书签）
DEMO_EMAIL=demo@hub.dev
DEMO_PASSWORD=demo12345

# 数据库与上传目录（相对项目根目录）
DB_FILE=data/hub.db
UPLOAD_DIR=data/uploads

# 单个上传文件大小上限（字节），默认 25 MiB
MAX_UPLOAD_BYTES=26214400

# 会话有效期（小时），默认 14 天
TOKEN_TTL_HOURS=336

# 通过 HTTPS 提供服务时设为 true，会话 Cookie 附加 Secure
COOKIE_SECURE=false

# 日志级别：debug | info | warn | error
LOG_LEVEL=debug
